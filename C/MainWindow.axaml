<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SWBF_C_build"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
        x:Class="SWBF_C_build.MainWindow"
        Title="SWBF III Wii Manager"
        Icon="avares://SWBF_C_build/Assets/SWBF3Icon.ico"
        Width="700" Height="450"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,10,10,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <Image Source="avares://SWBF_C_build/Assets/SWBF_Wii_Comb.png" 
                       Height="40" 
                       Stretch="Uniform"/>
                <TextBlock Text="SWBF III Wii Manager" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10">

            <TabItem x:Name="WizardTab" Header="Install SWBF3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15,10,10" Spacing="15" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="Setup Wizard for Star Wars Battlefront III Wii" FontSize="16" FontWeight="Bold"/>
                        
                        <TextBlock Text="1. Dolphin Setup Mode" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <RadioButton x:Name="AutoSetupRadio" Content="Automatic Setup (Recommended)" IsChecked="True"/>
                        <TextBlock Text="Downloads pre-configured builds and automatically sets paths." Foreground="#A0A0A0" FontSize="12" Margin="25,-10,0,5"/>
                        
                        <RadioButton x:Name="ManualSetupRadio" Content="Manual Setup"/>
                        <TextBlock Text="Downloads builds and opens Dolphin settings for manual configuration." Foreground="#A0A0A0" FontSize="12" Margin="25,-10,0,5" TextWrapping="Wrap"/>

                        <Separator Background="#333333" Margin="0,5"/>

                        <TextBlock Text="2. Choose Initial Build" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Select a build to download:" Foreground="#A0A0A0" FontSize="12" />
                        <ComboBox x:Name="WizardBuildComboBox" Width="400">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:BuildItem">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding InstallStatus, StringFormat='[{0}]'}" Foreground="#A0A0A0" FontSize="12" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Separator Background="#333333" Margin="0,5"/>

                        <TextBlock Text="3. Controller Setup" FontSize="14" FontWeight="SemiBold"/>
                        <CheckBox x:Name="SetupControlsCheckBox" Content="Configure Controls after installation" IsChecked="True"/>
                        <TextBlock Text="Opens Dolphin's control menu to map your inputs." Foreground="#A0A0A0" FontSize="12" Margin="25,-10,0,10"/>

                        <Separator Background="#333333" Margin="0,5"/>

                        <TextBlock Text="4. Desktop Shortcuts" FontSize="14" FontWeight="SemiBold"/>
                        <CheckBox x:Name="LauncherShortcutCheckBox" Content="Create a desktop shortcut for the SWBF III Wii Manager" IsChecked="True"/>
                        <TextBlock Text="Opens this manager." Foreground="#A0A0A0" FontSize="12" Margin="25,-10,0,5" TextWrapping="Wrap"/>
                        <CheckBox x:Name="BuildShortcutCheckBox" Content="Create a desktop shortcut for the selected build" IsChecked="True"/>
                        <TextBlock Text="Starts the game directly in Dolphin, without opening the manager." Foreground="#A0A0A0" FontSize="12" Margin="25,-10,0,10" TextWrapping="Wrap"/>

                        <Button x:Name="StartWizardButton" Content="Begin Installation" Background="White" Foreground="Black" Padding="16,8" Margin="0,15,0,0" Click="OnWizardStartClick"/>
                        
                        <ProgressBar x:Name="WizardProgressBar" Height="12" Value="0" Maximum="100" IsVisible="False" Margin="0,10,0,0"/>
                        <TextBlock x:Name="WizardStatusText" Text="" FontSize="12" Foreground="#A0A0A0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem x:Name="PlayModsTab" Header="Play/Mods">
                <Grid RowDefinitions="*, Auto" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*, 250" Margin="0,0,0,15">
                        
                        <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,10,0">
                            <!-- Build filter buttons (generated in code): "All" plus one per build tag -->
                            <StackPanel Grid.Row="0" Spacing="4" Margin="5,0,0,8">
                                <TextBlock Text="Show mods for build:" Foreground="#A0A0A0" FontSize="12"/>
                                <WrapPanel x:Name="BuildFilterPanel" Orientation="Horizontal"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="0" Padding="5">
                                <ListBox x:Name="ModListBox" SelectionMode="Multiple,Toggle">
                                    <ListBox.DataTemplates>
                                        <DataTemplate DataType="vm:BuildGroupHeader">
                                            <TextBlock Text="{Binding Title}" 
                                                    FontWeight="Bold" 
                                                    Foreground="#F3D448" 
                                                    Margin="0,8,0,4"/>
                                        </DataTemplate>
                                        
                                        <DataTemplate DataType="vm:ModItem">
                                            <Grid ColumnDefinitions="*, Auto" Margin="10,0,0,0">
                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding DisplaySize, StringFormat='({0})'}" Foreground="#A0A0A0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CompatibilityLabel}" Foreground="#808080" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InstallStatus}" Foreground="LightGray" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.DataTemplates>
                                </ListBox>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="0" Padding="12" IsVisible="{Binding !#DebugCheckBox.IsChecked}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Mod Details" FontWeight="SemiBold" FontSize="14"/>
                                <Separator Background="#333333" Margin="0,2"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                    <TextBlock x:Name="ModDetailsText" Text="Select a mod from the list to view release notes and download details." TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#121212" CornerRadius="0" Padding="8" IsVisible="{Binding #DebugCheckBox.IsChecked}">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Console Output" FontWeight="SemiBold" Foreground="#FFCACACA" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="1" x:Name="DebugConsoleTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#FFCACACA" FontFamily="Consolas, Monospace" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Spacing="2">
                            <ProgressBar x:Name="InstallProgressBar" Height="12" Value="0" Maximum="100"/>
                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Target Build:" VerticalAlignment="Center" Foreground="#A0A0A0"/>
                                <ComboBox x:Name="VersionComboBox" Width="220" VerticalAlignment="Center" SelectionChanged="OnVersionChanged">
                                    <ComboBox.DataTemplates>
                                        <DataTemplate DataType="vm:BuildGroupHeader">
                                            <TextBlock Text="{Binding Title}" 
                                                    FontWeight="Bold" 
                                                    Foreground="#F3D448" 
                                                    Margin="0,6,0,6"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="vm:BuildItem">
                                            <Grid ColumnDefinitions="*, Auto" Margin="12,0,0,0">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding InstallStatus, StringFormat='[{0}]'}" Foreground="#A0A0A0" FontSize="12" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.DataTemplates>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                <Button x:Name="RestoreControlsButton" Content="Restore Controls" Padding="12,8" Click="OnRestoreControlsClick"
                                        ToolTip.Tip="Puts Dolphin's Wii Remote 1 controls, Connect USB Keyboard and Reset hotkey back to how they were before KBM Controls was installed."/>
                                <Button x:Name="InstallButton" Content="Install Mod(s)" Background="White" Foreground="Black" Padding="16,8" Click="OnInstallButtonClick"/>
                                <Button x:Name="PlayButton" Content="Play" Background="Red" Foreground="White" Padding="16,8" Click="OnPlayButtonClick"/>
                                <Button x:Name="OpenDolphinButton" Content="Open Dolphin" Padding="12,8" Click="OnOpenDolphinClick"
                                        ToolTip.Tip="Opens Dolphin without starting a game, e.g. to change its settings or controls."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="ToolsTab" Header="Tools">
                <Grid RowDefinitions="*, Auto" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*, 250" Margin="0,0,0,15">
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="0" Padding="5" Margin="0,0,10,0">
                            <ListBox x:Name="ToolListBox" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ToolItem">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding DisplaySize, StringFormat='({0})'}" Foreground="#A0A0A0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding InstallStatus}" Foreground="LightGray" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="0" Padding="12" IsVisible="{Binding !#DebugCheckBox.IsChecked}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tool Details" FontWeight="SemiBold" FontSize="14"/>
                                <Separator Background="#333333" Margin="0,2"/>
                                <TextBlock x:Name="ToolDetailsText" Text="Select a tool from the list to view release notes and download details." TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#121212" CornerRadius="0" Padding="8" IsVisible="{Binding #DebugCheckBox.IsChecked}">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Console Output" FontWeight="SemiBold" Foreground="#FFCACACA" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="1" Text="{Binding #DebugConsoleTextBox.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#FFCACACA" FontFamily="Consolas, Monospace" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Spacing="2">
                            <ProgressBar x:Name="ToolProgressBar" Height="12" Value="0" Maximum="100"/>
                            <TextBlock x:Name="ToolStatusText" Text="Ready" FontSize="12" Foreground="#A0A0A0"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- Repair: restores a build's stock files from the r911 Repair Files -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Repair build:" VerticalAlignment="Center" Foreground="#A0A0A0"/>
                                <ComboBox x:Name="RepairBuildComboBox" Width="220" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:BuildItem">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="RepairButton" Content="Repair" Background="#8B0000" Foreground="White" Padding="16,8" Click="OnRepairClick"
                                        ToolTip.Tip="Restores the build's stock files (data, embed_wi_v4 and main.dol) from the r911 Repair Files, overwriting all mod changes."/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="InstallToolButton" Content="Install Tool" Background="White" Foreground="Black" Padding="16,8" Click="OnInstallButtonClick"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="BuildsTab" Header="Builds">
                <Grid RowDefinitions="*, Auto" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*, 250" Margin="0,0,0,15">
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="0" Padding="5" Margin="0,0,10,0">
                            <ListBox x:Name="Wii_Builds" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:BuildItem">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding DisplaySize, StringFormat='({0})'}" Foreground="#A0A0A0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding InstallStatus}" Foreground="LightGray" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="0" Padding="12" IsVisible="{Binding !#DebugCheckBox.IsChecked}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Build Details" FontWeight="SemiBold" FontSize="14"/>
                                <Separator Background="#333333" Margin="0,2"/>
                                <TextBlock x:Name="Wii_Builds_DetailsText" Text="Select a build from the list to view release notes and download details." TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#121212" CornerRadius="0" Padding="8" IsVisible="{Binding #DebugCheckBox.IsChecked}">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Console Output" FontWeight="SemiBold" Foreground="#FFCACACA" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="1" Text="{Binding #DebugConsoleTextBox.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#FFCACACA" FontFamily="Consolas, Monospace" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Spacing="2">
                            <ProgressBar x:Name="BuildsProgressBar" Height="12" Value="0" Maximum="100"/>
                            <TextBlock x:Name="BuildsStatusText" Text="Ready" FontSize="12" Foreground="#A0A0A0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                            <Button x:Name="Install_Build_Button" Content="Install Build" Background="White" Foreground="Black" Padding="16,8" Click="OnInstallButtonClick"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15,10,10" Spacing="15" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock x:Name="VersionText" Text="Version: 8.0" FontSize="16"/>
                        <TextBlock Text="Directories &amp; Paths" FontSize="16" FontWeight="SemiBold"/>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="Builds Directory:" Foreground="#A0A0A0" FontSize="12"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" x:Name="BuildsPathTextBox" Watermark="/path/to/builds/"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseBuildsPathClick"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="General Mods Directory (mods for all builds):" Foreground="#A0A0A0" FontSize="12"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" x:Name="ModPathTextBox" Watermark="/path/to/mods/"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseModPathClick"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Appdata Directory:" Foreground="#A0A0A0" FontSize="12"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" x:Name="AppdataPathTextBox" Watermark="/path/to/appdata/"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseAppdataPathClick"/>
                            </Grid>
                        </StackPanel>

                        <Separator Background="#333333" Margin="0,5"/>

                        <TextBlock Text="Updates &amp; Integration" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox x:Name="AutoUpdateCheckBox" Content="Automatically check for updates on launch" IsChecked="True"
                                  IsCheckedChanged="OnAutoUpdateCheckChanged"/>
                        <CheckBox Content="Keep temporary download zip files after installation"/>
                        <CheckBox x:Name="DebugCheckBox" Content="Debug/Console Output" IsChecked="False"/>

                        <StackPanel Spacing="4">
                            <Button x:Name="UpdateButton" Content="Check for Updates" Padding="16,8" Click="OnCheckForUpdatesClick"/>
                            <ProgressBar x:Name="UpdateProgressBar" Height="8" Maximum="100" IsVisible="False"/>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ResetConfigButton" Content="Reset Config" Padding="16,8" Click="OnResetConfigClick" Background="#8B0000" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>